# WEEX API Credentials (Required)
WEEX_API_KEY=your-api-key
WEEX_SECRET_KEY=your-secret-key
WEEX_PASSPHRASE=your-passphrase
WEEX_API_URL=https://api-contract.weex.com

# WhyMe Quant Main Server (Optional - for dashboard integration)
MAIN_SERVER_URL=https://whyme-quant.swmengappdev.workers.dev
NODE_API_KEY=your-node-api-key

# Redis (for pub/sub and caching)
REDIS_URL=redis://redis:6379

# AI Model Configuration (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=xiaomi/mimo-v2-flash:free
LLM_HTTP_REFERER=https://whymelabs.com
LLM_APP_NAME=WhyMe Quant Strategy Engine

# Legacy AI Keys (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Discord Notifications
DISCORD_WEBHOOK_URL=your-discord-webhook-url
DISCORD_BOT_NAME=WhyMe Quant Bot
DISCORD_BOT_AVATAR=

# Trading Loop
MAIN_LOOP_INTERVAL=5
ERROR_BACKOFF_INTERVAL=10

# Logging
LOG_LEVEL=INFO

# Strategy Configuration
MAX_POSITION_SIZE=1000
MAX_LEVERAGE=20
DEFAULT_SYMBOL=BTCUSDT
# Multiple trading pairs (comma-separated) - more pairs = more opportunities
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Heartbeat
HEARTBEAT_INTERVAL=30

# AI Log Upload
AI_LOG_UPLOAD_INTERVAL=30
AI_LOG_BATCH_SIZE=10
